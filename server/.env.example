# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local MongoDB: mongodb://127.0.0.1:27017/food_genie
# Atlas MongoDB: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/food_genie?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/food_genie

# Client CORS URL
CLIENT_URL=http://localhost:5173

# Authentication (Phase 2)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_EXPIRE=7d

# AI Recommendation Engine (Phase 6)
# Default engine is 'heuristic' (built-in intelligent heuristic NLP engine, zero dependencies/cost)
# Optional: 'gemini' or 'openai' when an external API key is provided
AI_PROVIDER=heuristic
AI_API_KEY=


